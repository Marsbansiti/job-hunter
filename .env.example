# Telegram Bot Configuration (Option A: Bot API via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Telegram User API Configuration (Option B: Telethon User Session)
# Optional: if you prefer using a Telegram user session instead of a bot
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION=user.session
TELEGRAM_TARGET_CHAT=me
